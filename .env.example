# Local development placeholders only. Never use these values in production.
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
POSTGRES_USER=nihongocore_dev
POSTGRES_PASSWORD=local_development_only
POSTGRES_DB=nihongocore_dev
POSTGRES_PORT=15432
DATABASE_URL=postgresql://nihongocore_dev:local_development_only@localhost:15432/nihongocore_dev?schema=public
