# Local development placeholders only. Never use these values in production.
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
POSTGRES_USER=nihongocore_dev
POSTGRES_PASSWORD=local_development_only
POSTGRES_DB=nihongocore_dev
POSTGRES_PORT=15432
DATABASE_URL=postgresql://nihongocore_dev:local_development_only@localhost:15432/nihongocore_dev?schema=public
# Authentication secrets must be independently generated and at least 32 characters.
JWT_ACCESS_SECRET=replace_with_a_unique_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_unique_refresh_pepper_at_least_32_chars
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_IDLE_TTL_SECONDS=604800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=2592000
AUTH_JWT_ISSUER=nihongocore-api
AUTH_JWT_AUDIENCE=nihongocore-client
AUTH_REFRESH_COOKIE_NAME=nihongocore_refresh
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10
# Public client configuration. Also set this in apps/client/.env.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
