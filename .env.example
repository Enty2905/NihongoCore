JWT_ACCESS_SECRET=replace_before_authentication
JWT_REFRESH_SECRET=replace_before_authentication
# Public client configuration. Also set this in apps/client/.env.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
